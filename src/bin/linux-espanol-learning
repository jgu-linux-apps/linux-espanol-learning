#!/usr/bin/python3
import os
import sys

for base in ("/usr/share/linux-espanol-learning",
             os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src")):
    if os.path.isdir(os.path.join(base, "espanol")):
        sys.path.insert(0, os.path.abspath(base))
        break

from espanol.ui.app import main  # noqa: E402

sys.exit(main())
